# Copy to .env for local development. NEVER commit .env.
#
# Nothing in the harness requires a model provider until milestone M3
# (`docs/06-roadmap.md`). The deterministic spine (schemas, sensors, simulator)
# runs with zero credentials — by design.

# --- model provider (M3+, decided in docs/07-open-questions.md Q4) ---
# ARCHERY_MODEL_PROVIDER=openai | anthropic | gemini | ollama
# ARCHERY_MODEL_ID=
# ARCHERY_API_KEY=

# --- harness budgets (guards, not suggestions) ---
ARCHERY_MAX_STEPS_PER_TURN=40
ARCHERY_MAX_TOOL_CALLS_PER_TURN=60
ARCHERY_MAX_TOKENS_PER_RUN=150000
ARCHERY_REQUIRE_WRITE_APPROVAL=true

# --- storage ---
ARCHERY_DB_PATH=data/archery.db
ARCHERY_ARTIFACT_DIR=data/artifacts
