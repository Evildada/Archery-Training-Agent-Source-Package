{
  "$defs": {
    "ObservationSource": {
      "enum": [
        "self_reported",
        "coach_rated",
        "sensor",
        "derived",
        "imported"
      ],
      "title": "ObservationSource",
      "type": "string"
    },
    "ParameterObservation": {
      "additionalProperties": false,
      "description": "One measured/rated/derived value of one parameter, at one point in time.",
      "properties": {
        "archer_id": {
          "title": "Archer Id",
          "type": "string"
        },
        "cycle_template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle Template Id"
        },
        "distance_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "end_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Id"
        },
        "equipment_set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equipment Set Id"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reliability": {
          "$ref": "#/$defs/Reliability",
          "default": "medium"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        },
        "source": {
          "$ref": "#/$defs/ObservationSource",
          "default": "self_reported"
        },
        "target_face_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Face Id"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "archer_id",
        "key",
        "value"
      ],
      "title": "ParameterObservation",
      "type": "object"
    },
    "Reliability": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Reliability",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What capture produces and what the ledger accepts or rejects \u2014 with reasons.",
  "properties": {
    "accepted": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParameterObservation"
      },
      "title": "Accepted",
      "type": "array"
    },
    "rejected": {
      "default": [],
      "description": "[{'key':..., 'reason':...}] \u2014 never silently dropped.",
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Rejected",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "ObservationBatch",
  "type": "object"
}
