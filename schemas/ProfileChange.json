{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An append-only note that a profile field changed, with an effective date.",
  "properties": {
    "archer_id": {
      "title": "Archer Id",
      "type": "string"
    },
    "change_id": {
      "title": "Change Id",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "field": {
      "title": "Field",
      "type": "string"
    },
    "new_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Value"
    },
    "old_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old Value"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "archer_id",
    "field"
  ],
  "title": "ProfileChange",
  "type": "object"
}
