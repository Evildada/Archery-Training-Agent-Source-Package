{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archer_id": {
      "title": "Archer Id",
      "type": "string"
    },
    "keys": {
      "description": "Empty = all parameters.",
      "items": {
        "type": "string"
      },
      "title": "Keys",
      "type": "array"
    },
    "limit": {
      "default": 200,
      "maximum": 2000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "since": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Since"
    },
    "until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Until"
    }
  },
  "required": [
    "archer_id"
  ],
  "title": "LedgerReadInput",
  "type": "object"
}
