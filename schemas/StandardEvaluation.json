{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The result of checking one standard against one window of the archer's data.",
  "properties": {
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "n": {
      "default": 0,
      "minimum": 0,
      "title": "N",
      "type": "integer"
    },
    "observed_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Value"
    },
    "passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = not evaluable (insufficient n / missing data).",
      "title": "Passed"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "standard_id": {
      "title": "Standard Id",
      "type": "string"
    }
  },
  "required": [
    "standard_id"
  ],
  "title": "StandardEvaluation",
  "type": "object"
}
