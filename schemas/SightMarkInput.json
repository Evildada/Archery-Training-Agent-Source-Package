{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "marks": {
      "description": "Measured [distance_m, sight_mark] pairs, at least two.",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "minItems": 2,
      "title": "Marks",
      "type": "array"
    },
    "target_distance_m": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "title": "Target Distance M",
      "type": "number"
    }
  },
  "required": [
    "marks",
    "target_distance_m"
  ],
  "title": "SightMarkInput",
  "type": "object"
}
