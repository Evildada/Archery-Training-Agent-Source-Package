{
  "$defs": {
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "repairs": {
          "default": 0,
          "title": "Repairs",
          "type": "integer"
        },
        "steps": {
          "default": 0,
          "title": "Steps",
          "type": "integer"
        },
        "tokens": {
          "default": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "write_drafts": {
          "default": 0,
          "title": "Write Drafts",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "Confidence": {
      "description": "How a *number* was obtained. Required on every tool result (docs/04 \u00a710).",
      "enum": [
        "measured",
        "derived",
        "estimated",
        "interpolated",
        "unverified",
        "insufficient_data"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "failures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "repair_hint": {
          "default": "",
          "title": "Repair Hint",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "passed"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "data_snapshot_hash": {
          "default": "",
          "title": "Data Snapshot Hash",
          "type": "string"
        },
        "harness_version": {
          "default": "0.0.1",
          "title": "Harness Version",
          "type": "string"
        },
        "tool_version": {
          "default": "0.0.1",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ToolObservation": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "$ref": "#/$defs/ToolResult"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "result"
      ],
      "title": "ToolObservation",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "The uniform result envelope \u2014 see docs/04 \u00a710.",
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "insufficient_data"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ToolResult",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "answered",
        "clarify",
        "refer",
        "insufficient",
        "budget_exhausted"
      ],
      "title": "Action",
      "type": "string"
    },
    "answer": {
      "default": "",
      "title": "Answer",
      "type": "string"
    },
    "context_audit": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Context Audit",
      "type": "object"
    },
    "event_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Event Counts",
      "type": "object"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "action"
  ],
  "title": "TurnResult",
  "type": "object"
}
