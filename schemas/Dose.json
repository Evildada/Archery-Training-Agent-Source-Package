{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "How much work. At least one dimension must be specified (checked by the instruction).",
  "properties": {
    "arrows": {
      "anyOf": [
        {
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arrows"
    },
    "duration_min": {
      "anyOf": [
        {
          "maximum": 240,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Min"
    },
    "ends": {
      "anyOf": [
        {
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ends"
    },
    "reps": {
      "anyOf": [
        {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reps"
    },
    "sets": {
      "anyOf": [
        {
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sets"
    }
  },
  "title": "Dose",
  "type": "object"
}
