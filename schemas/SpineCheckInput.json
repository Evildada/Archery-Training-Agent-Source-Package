    },
    "arrow_length_in": {
      "exclusiveMinimum": 0,
      "maximum": 34,
      "title": "Arrow Length In",
      "type": "number"
    },
    "draw_weight_lb": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "title": "Draw Weight Lb",
      "type": "number"
    },
    "point_mass_grains": {
      "default": 100.0,
