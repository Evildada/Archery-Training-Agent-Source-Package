{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One field that differs between two versions. Signed where numeric.",
  "properties": {
    "delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "new - old, when both parse as numbers. Signed, so direction is not lost.",
      "title": "Delta"
    },
    "field": {
      "description": "Dotted path, e.g. 'arrow.point_mass_grains'.",
      "title": "Field",
      "type": "string"
    },
    "new_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Value"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "old_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old Value"
    }
  },
  "required": [
    "field"
  ],
  "title": "EquipmentChange",
  "type": "object"
}
