{
  "$defs": {
    "Confidence": {
      "description": "How a *number* was obtained. Required on every tool result (docs/04 \u00a710).",
      "enum": [
        "measured",
        "derived",
        "estimated",
        "interpolated",
        "unverified",
        "insufficient_data"
      ],
      "title": "Confidence",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One labelled statement about the setup.",
  "properties": {
    "assumptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "basis": {
      "description": "What this was computed from. Never empty.",
      "title": "Basis",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "confirming_test": {
      "default": "",
      "description": "The single range test that would raise this to MEASURED.",
      "title": "Confirming Test",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "subject": {
      "description": "Registry key where one exists, else a report-local name.",
      "title": "Subject",
      "type": "string"
    },
    "unit": {
      "default": "",
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "subject",
    "statement",
    "confidence",
    "basis"
  ],
  "title": "Finding",
  "type": "object"
}
